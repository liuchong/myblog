{
  "name": "myblog",
  "private": true,
  "type": "module",
  "description": "刘冲的个人博客，基于 Vite、React 和 Markdown 构建。",
  "version": "0.1.0",
  "author": "刘冲",
  "bugs": {
    "url": "https://github.com/liuchong/myblog/issues"
  },
  "dependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "@fontsource-variable/montserrat": "^5.0.19",
    "@fontsource/merriweather": "^5.0.13",
    "prismjs": "^1.30.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rehype-prism-plus": "^2.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "vite": "^8.2.2",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.0",
    "gh-pages": "^6.3.0",
    "prettier": "^3.3.2"
  },
  "homepage": "https://blakat.cc/",
  "keywords": [
    "blog",
    "vite",
    "react",
    "markdown"
  ],
  "license": "0BSD",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liuchong/myblog.git"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "develop": "node scripts/prepare-data.mjs && vite --host 127.0.0.1",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "start": "npm run develop",
    "serve": "vite preview --host 127.0.0.1",
    "clean": "node scripts/clean.mjs",
    "test": "npm run format:check"
  }
}
